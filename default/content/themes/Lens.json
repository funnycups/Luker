{
    "name": "Lens",
    "font_scale": 1.01,
    "blur_strength": 8,
    "fast_ui_mode": false,
    "shadow_width": 0,
    "waifuMode": false,
    "avatar_style": 3,
    "chat_display": 1,
    "toastr_position": "toast-top-center",
    "noShadows": true,
    "chat_width": 55,
    "timer_enabled": true,
    "timestamps_enabled": true,
    "timestamp_model_icon": false,
    "mesIDDisplay_enabled": true,
    "hideChatAvatars_enabled": false,
    "message_token_count_enabled": true,
    "expand_message_actions": false,
    "enableZenSliders": false,
    "enableLabMode": false,
    "hotswap_enabled": true,
    "bogus_folders": true,
    "zoomed_avatar_magnification": true,
    "reduced_motion": true,
    "compact_input_area": true,
    "show_swipe_num_all_messages": true,
    "click_to_edit": false,
    "media_display": "list",
    "main_text_color": "rgba(238, 241, 247, 1)",
    "italics_text_color": "rgba(156, 166, 186, 1)",
    "underline_text_color": "rgba(182, 152, 248, 1)",
    "quote_text_color": "rgba(134, 178, 177, 1)",
    "blur_tint_color": "rgba(26, 31, 44, 1)",
    "chat_tint_color": "rgba(0, 0, 0, 0)",
    "user_mes_blur_tint_color": "rgba(36, 52, 78, 1)",
    "bot_mes_blur_tint_color": "rgba(26, 31, 44, 1)",
    "shadow_color": "rgba(0, 0, 0, 0.55)",
    "border_color": "rgba(255, 255, 255, 0.085)",
    "palettes": {
        "default": "night",
        "auto": {
            "dark": "night",
            "light": "mist",
            "swatch": "linear-gradient(90deg, #161d2e 50%, #eef2f7 50%)"
        },
        "items": [
            {
                "id": "night",
                "label": "Night",
                "title": "Night Sky",
                "theme_color": "#07090f",
                "swatch": "linear-gradient(135deg, #25488e 0%, #0b1020 58%, #86b2b1 100%)"
            },
            {
                "id": "mist",
                "label": "Mist",
                "title": "Morning Mist",
                "theme_color": "#e8ecf3",
                "swatch": "linear-gradient(135deg, #b8d1f5 0%, #f6f8fc 58%, #2a7a7b 100%)"
            },
            {
                "id": "ink",
                "label": "Ink",
                "title": "Obsidian Ink",
                "theme_color": "#0f1219",
                "swatch": "linear-gradient(135deg, #27354b 0%, #101319 60%, #68b8b0 100%)"
            },
            {
                "id": "paper",
                "label": "Paper",
                "title": "Warm Paper",
                "theme_color": "#efece5",
                "swatch": "linear-gradient(135deg, #fbfaf7 0%, #e4eae7 58%, #38726a 100%)"
            }
        ]
    },
    "custom_css": "",
    "builtin_stylesheet": "css/themes/lens.css"
}
