{
  "name": "luker-desktop",
  "productName": "Luker",
  "version": "1.0.0",
  "description": "Luker desktop client",
  "homepage": "https://github.com/funnycups/Luker",
  "repository": {
    "type": "git",
    "url": "https://github.com/funnycups/Luker"
  },
  "author": "Luker",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare:backend": "node scripts/prepare-backend.mjs",
    "build:mac": "node scripts/build-desktop.mjs mac",
    "build:win": "node scripts/build-desktop.mjs win",
    "build:linux": "node scripts/build-desktop.mjs linux"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.luker.desktop",
    "productName": "Luker",
    "artifactName": "Luker-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "appimage-update.js",
      "data-location.js",
      "http-auth.js",
      "http-auth.html",
      "http-auth-preload.js",
      "install-flavour.js",
      "window-behaviour.js",
      "preload.js",
      "loading.html",
      "tray-icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".staging/luker",
        "to": "luker"
      },
      {
        "from": ".staging/luker/node_modules",
        "to": "luker/node_modules"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": "-"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "Luker <support@cups.moe>"
    }
  }
}
