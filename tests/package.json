{
    "name": "sillytavern-tests",
    "type": "module",
    "license": "AGPL-3.0",
    "scripts": {
        "test": "npm run test:unit && npm run test:e2e",
        "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.json",
        "test:unit:serial": "NODE_OPTIONS=--max-old-space-size=8192 node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.json --runInBand --forceExit",
        "test:e2e": "playwright test --project=e2e",
        "test:integration": "PW_INCLUDE_INTEGRATION=1 playwright test",
        "test:e2e:skills:smoke": "PW_INCLUDE_INTEGRATION=1 playwright test --project=skills-ui",
        "lint": "eslint \"**/*.js\" ./*.js",
        "lint:fix": "eslint \"**/*.js\" ./*.js --fix"
    },
    "dependencies": {
        "@playwright/test": "^1.56.1",
        "@types/jest": "^29.5.12",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "lodash": "4.17.21"
    },
    "devDependencies": {
        "jest-environment-jsdom": "^29.7.0",
        "supertest": "^7.2.2",
        "testcontainers": "^12.0.3"
    }
}
