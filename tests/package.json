{
    "name": "sillytavern-tests",
    "type": "module",
    "license": "AGPL-3.0",
    "scripts": {
        "test": "npm run test:unit && npm run test:storage:local && npm run test:storage:sql && npm run test:e2e",
        "test:all": "npm test && npm run test:e2e:desktop && npm run test:e2e:desktop:packaged",
        "test:unit": "node harness/run.js --profile unit",
        "test:unit:serial": "NODE_OPTIONS=--max-old-space-size=8192 node harness/run.js --profile unit --framework jest -- --runInBand",
        "test:storage:local": "node harness/run.js --profile storage-local",
        "test:storage:sql": "node harness/run.js --profile storage-sql -- --maxWorkers=2",
        "test:e2e": "node harness/run.js --profile e2e && node harness/run.js --profile frontend",
        "test:e2e:desktop": "node harness/run.js --profile desktop",
        "test:e2e:desktop:packaged": "node harness/run.js --profile desktop-packaged",
        "test:compatibility": "node harness/run.js --profile compatibility",
        "test:integration": "node harness/run.js --profile e2e && node harness/run.js --profile frontend",
        "lint": "eslint \"**/*.js\" ./*.js",
        "lint:fix": "eslint \"**/*.js\" ./*.js --fix"
    },
    "dependencies": {
        "@playwright/test": "^1.64.1",
        "@types/jest": "^29.5.12",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "lodash": "4.17.21"
    },
    "devDependencies": {
        "jest-environment-jsdom": "^29.7.0",
        "supertest": "^7.2.2",
        "testcontainers": "^12.0.3"
    }
}
