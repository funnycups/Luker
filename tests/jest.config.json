{
    "projects": [
        {
            "displayName": "unit",
            "globalSetup": "<rootDir>/util/global-setup.js",
            "testEnvironment": "<rootDir>/harness/jest-environment.js",
            "transform": {},
            "setupFiles": [
                "<rootDir>/harness/jest-profile-unit.js",
                "<rootDir>/jest.setup.js"
            ],
            "setupFilesAfterEnv": [
                "<rootDir>/harness/jest-data-root.js",
                "<rootDir>/harness/jest-storage-hooks.js"
            ],
            "testMatch": [
                "<rootDir>/**/?(*.)+(test).js"
            ],
            "testPathIgnorePatterns": [
                "/node_modules/",
                "/frontend/",
                "/tests/storage/",
                "/tests/sync/",
                "/tests/endpoints/character-export-skills.test.js",
                "/tests/endpoints/users-admin-global-extensions.test.js"
            ],
            "moduleNameMapper": {
                "^supertest$": "<rootDir>/util/supertest-loopback.cjs",
                "^(.*/)?public/lib\\.js$": "<rootDir>/util/lib-stub.js",
                "^\\.{1,2}/lib\\.core\\.bundle\\.js$": "<rootDir>/util/lib-stub.js",
                "^\\.{1,2}/lib\\.optional\\.bundle\\.js$": "<rootDir>/util/lib-stub.js",
                "^/script\\.js$": "<rootDir>/../public/script.js",
                "^/lib\\.js$": "<rootDir>/util/lib-stub.js",
                "^/scripts/(.*)$": "<rootDir>/../public/scripts/$1",
                "^(.*/)?dialog-polyfill\\.esm\\.js$": "<rootDir>/util/dialog-polyfill-stub.js"
            }
        },
        {
            "displayName": "storage-local",
